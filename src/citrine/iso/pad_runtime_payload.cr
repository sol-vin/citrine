require "base64"

module Citrine
  module ISO
    module PadRuntimePayload
      VADDR            = 0x00480000_u32
      INIT_ENTRY       = 0x00480000_u32
      POLL_ENTRY       = 0x00480010_u32
      SOUND_PLAY_ENTRY = 0x00480020_u32
      SOUND_STOP_ENTRY = 0x00480030_u32
      MEM_SIZE         = 0x00006000_u32

      B64_DATA = ""

      @@cached_bytes : Bytes? = nil

      def self.bytes : Bytes
        if raw = @@cached_bytes
          return raw
        end
        decoded = Base64.decode(B64_DATA).dup

        # Relocate payload from original base 0x00180000 to VADDR
        old_base = 0x00180000_u32
        delta = VADDR - old_base
        delta_hi = (delta >> 16).to_u16

        if delta != 0_u32
          (0...(decoded.size // 4)).each do |i|
            off = i * 4
            w = IO::ByteFormat::LittleEndian.decode(UInt32, decoded[off, 4])
            op = w >> 26
            if op == 2 || op == 3 # J or JAL
              target = (w & 0x03FFFFFF) << 2
              if target >= old_base && target < (old_base + 0x00010000)
                new_target = target + delta
                new_w = (op << 26) | ((new_target >> 2) & 0x03FFFFFF)
                IO::ByteFormat::LittleEndian.encode(new_w, decoded[off, 4])
              end
            elsif op == 0x0F # LUI
              imm = (w & 0xFFFF).to_u16
              if imm == 0x0018 || imm == 0x0019
                new_imm = imm + delta_hi
                new_w = (w & 0xFFFF0000) | (new_imm.to_u32 & 0xFFFF)
                IO::ByteFormat::LittleEndian.encode(new_w, decoded[off, 4])
              end
            elsif w >= old_base && w < (old_base + 0x00010000)
              new_w = w + delta
              IO::ByteFormat::LittleEndian.encode(new_w, decoded[off, 4])
            end
          end
        end

        # Patch SOUND_PLAY_ENTRY delay slot (0x002c): move a3, a0 (allows passing sound cmd in A0)
        decoded[0x2c, 4].copy_from(Bytes[0x21, 0x38, 0x80, 0x00])
        # Patch SOUND_STOP_ENTRY (0x0038): j (VADDR + 0x3424); (0x003c): move a3, zero (sends cmd 0)
        stop_target = (VADDR + 0x3424_u32) >> 2
        stop_inst = (2_u32 << 26) | (stop_target & 0x03FFFFFF)
        IO::ByteFormat::LittleEndian.encode(stop_inst, decoded[0x38, 4])
        decoded[0x3c, 4].copy_from(Bytes[0x21, 0x38, 0x00, 0x00])
        # Patch 0x345c: move a2, a3 (passes cmd to SIF packet [a0 + 0xc])
        decoded[0x345c, 4].copy_from(Bytes[0x21, 0x30, 0xe0, 0x00])
        @@cached_bytes = decoded
      end
    end
  end
end